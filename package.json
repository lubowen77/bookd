{
  "name": "bookd",
  "version": "0.1.0",
  "description": "本地优先的 AI 伴读阅读器",
  "type": "module",
  "bin": {
    "bookd": "dist/cli.js",
    "bookd-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "dist-client",
    "integrations",
    "docs/design",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/cli.ts serve --port 4123\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "npm run build:server && vite build",
    "build:server": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.server.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["ebook", "epub", "mobi", "azw3", "markdown", "mcp", "reader"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "foliate-js": "^1.0.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "turndown": "^7.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
